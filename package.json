{
  "version": "0.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build && tixyel b -b none",
    "compile": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint widget/src/scripts tests",
    "lint:scss": "stylelint \"widget/src/styles/**/*.scss\"",
    "format": "prettier --write widget/src/scripts tests",
    "format:check": "prettier --check widget/src/scripts tests",
    "typecheck": "tsc --noEmit",
    "fix": "eslint --fix widget/src/scripts tests && prettier --write widget/src/scripts tests"
  },
  "devDependencies": {
    "@tixyel/cli": "3.6.0",
    "@types/node": "25.9.3",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "65.0.1",
    "jiti": "2.7.0",
    "prettier": "3.8.4",
    "rollup-plugin-external-globals": "0.13.0",
    "sass": "1.101.0",
    "stylelint": "17.13.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@tixyel/streamelements": "7.14.1",
    "motion": "12.40.0"
  }
}
