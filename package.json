{
  "name": "stream-guestbook-widget",
  "version": "0.3.18",
  "description": "A free StreamElements browser-source widget for Twitch, YouTube and Kick - viewers sign a virtual guestbook via chat command or Channel Points.",
  "license": "MIT",
  "author": "wielorzeczownik",
  "homepage": "https://github.com/wielorzeczownik/stream-guestbook-widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wielorzeczownik/stream-guestbook-widget.git"
  },
  "bugs": {
    "url": "https://github.com/wielorzeczownik/stream-guestbook-widget/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build && tixyel b -b none",
    "compile": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint widget/src/scripts widget/src/index.html tests",
    "lint:scss": "stylelint \"widget/src/styles/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fix": "eslint --fix widget/src/scripts widget/src/index.html tests && stylelint --fix \"widget/src/styles/**/*.scss\" && prettier --write ."
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "0.64.0",
    "@html-eslint/parser": "0.64.0",
    "@tixyel/cli": "3.6.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "72.0.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "rollup-plugin-external-globals": "0.13.0",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tixyel/streamelements": "7.14.1",
    "motion": "12.43.0"
  }
}
